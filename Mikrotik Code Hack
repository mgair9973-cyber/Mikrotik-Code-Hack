class VoucherTool:
    def __init__(self):
        self.proxy_manager = ProxyManager()
        self.debug = False
        self.use_proxy = False
        self.length = 7
        self.login_url = ""

    def set_debug(self, enabled: bool): self.debug = enabled
    def set_length(self, length: int):
        if length in [6,7,8,9]:
            self.length = length
            print(f"{GREEN}[+]{RESET} Code length set to {length} digits")
        else:
            print(f"{RED}[-]{RESET} Invalid. Using 7.")
            self.length = 7
    def get_min_max(self):
        return 10**(self.length-1), (10**self.length)-1

    async def check_url(self, url, proxy=None):
        try:
            connector = aiohttp.TCPConnector(limit=10)
            async with aiohttp.ClientSession(connector=connector) as session:
                proxy_url = f"http://{proxy}" if proxy else None
                async with session.get(url, timeout=5, allow_redirects=False, proxy=proxy_url) as resp:
                    return resp.status == 200
        except: return False

    async def wait_for_url(self, url):
        print(f"\n{BLUE}[*]{RESET} Waiting for URL to be ready: {url}")
        attempt=0
        while True:
            attempt+=1
            if await self.check_url(url):
                print(f"{GREEN}✅ URL is READY (200 OK){RESET}")
                return True
            print(f"{YELLOW}[!]{RESET} Attempt {attempt}: URL not ready. Retry in 5s...")
            await asyncio.sleep(5)

    async def test_internet(self, session, proxy=None):
        for url in ["https://www.google.com","https://fast.com","https://cloudflare.com"]:
            try:
                proxy_url = f"http://{proxy}" if proxy else None
                async with session.get(url, timeout=5, allow_redirects=True, proxy=proxy_url) as resp:
                    if resp.status == 200: return True
            except: continue
        return False

    async def check_voucher(self, login_url: str, voucher: str, proxy=None) -> Tuple[str, Optional[str]]:
        params = {"username": voucher, "password": ""}
        headers = {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.5",
            "Connection": "keep-alive"
        }
        proxy_url = f"http://{proxy}" if proxy else None
        try:
            connector = aiohttp.TCPConnector(limit=10)
            async with aiohttp.ClientSession(connector=connector) as session:
                async with session.get(login_url, params=params, headers=headers,
                                       timeout=10, allow_redirects=False, proxy=proxy_url) as resp:
                    status = resp.status
                    if status in (301,302,307,308):
                        location = dict(resp.headers).get('Location','')
                        if '/status' in location:
                            if await self.test_internet(session, proxy):
                                return "found", location
                            return "expired", location
                        return "invalid", None
                    elif status == 200:
                        text = await resp.text()
                        if "Requires authorization" in text or "authorization required" in text.lower():
                            return "expired", None
                        meta = re.search(r'<meta\s+http-equiv=["\']refresh["\']\s+content=["\'][^"\']*url=([^"\']+)["\']', text, re.I)
                        if meta:
                            refresh_url = meta.group(1).strip()
                            if '/status' in refresh_url:
                                if await self.test_internet(session, proxy):
                                    return "found", refresh_url
                                return "expired", refresh_url
                            return "invalid", None
                        return "invalid", None
                    elif status == 429 or status >= 500:
                        return "retry", None
                    else:
                        return "error", None
        except asyncio.TimeoutError:
            return "retry", None
        except Exception:
            return "error", None

