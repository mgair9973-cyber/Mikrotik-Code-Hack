        url = input(f"{YELLOW}→{RESET} Enter login URL (e.g., http://192.168.1.1/login): ").strip()
        tool.login_url = url

    if not tool.login_url:
        print(f"{RED}[-] No URL! Exiting.{RESET}")
        return

    await tool.wait_for_url(tool.login_url)

    while True:
        print(f"\n{CYAN}═══════════════════════════════════════════════════════════════{RESET}")
        print(f"{YELLOW}[?]{RESET} Choose Mode:")
        print(f"  0. {MAGENTA}Change Code Length (Current: {tool.length} digits){RESET}")
        print(f"  1. {BLUE}Input Voucher{RESET}")
        print(f"  2. {BLUE}Scan Voucher{RESET} (sequential, uses test.txt)")
        print(f"  3. {MAGENTA}Random Hit{RESET} (prefix based)")
        print(f"  4. {RED}Exit{RESET}")
        print(f"  5. {GREEN}Re-detect MikroTik URL{RESET}")
        print(f"{CYAN}═══════════════════════════════════════════════════════════════{RESET}")

        choice = input(f"{YELLOW}→{RESET} ").strip()
        if choice == '0':
            print("\n 1. 6 digits\n 2. 7 digits\n 3. 8 digits\n 4. 9 digits")
            new = input(f"{YELLOW}→{RESET} Enter choice (1-4): ").strip()
            if new == '1': tool.set_length(6)
            elif new == '3': tool.set_length(8)
            elif new == '4': tool.set_length(9)
            else: tool.set_length(7)
        elif choice == '1':
            await tool.input_voucher_mode(tool.login_url)
        elif choice == '2':
            await tool.scan_voucher_mode(tool.login_url)
        elif choice == '3':
            await tool.random_hit_mode(tool.login_url)
        elif choice == '4':
            print(f"\n{GREEN}Goodbye!{RESET}")
            break
        elif choice == '5':
            detected = await auto_detect_mikrotik()
            if detected:
                tool.login_url = detected
                print(f"{GREEN}[+] URL updated to: {detected}{RESET}")
                await tool.wait_for_url(tool.login_url)
            else:
                print(f"{RED}[-] No MikroTik found.{RESET}")
        else:
            print(f"{RED}Invalid choice.{RESET}")

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print(f"\n{YELLOW}⚠️ Interrupted{RESET}")
    except Exception as e:
        print(f"{RED}Error: {e}{RESET}")
        import traceback
        traceback.print_exc()
