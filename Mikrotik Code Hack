def print_progress_bar(percentage, width=30):
    filled = int(width * percentage / 100)
    bar = '█' * filled + '░' * (width - filled)
    return f"[{bar}]"

class ProxyManager:
    def __init__(self):
        self.proxies = []
        self.current_index = 0
        self.failed_proxies = set()
    def load_proxies(self, file_path="proxies.txt"):
        try:
            if os.path.exists(file_path):
                with open(file_path, "r") as f:
                    self.proxies = [line.strip() for line in f if line.strip()]
                print(f"{GREEN}[+]{RESET} Loaded {len(self.proxies)} proxies")
                return True
        except: pass
        print(f"{YELLOW}[!]{RESET} No proxy file found. Using direct connection.")
        return False
    def get_next_proxy(self) -> Optional[str]:
        if not self.proxies: return None
        attempts = 0
        while attempts < len(self.proxies):
            proxy = self.proxies[self.current_index % len(self.proxies)]
            self.current_index += 1
            if proxy not in self.failed_proxies:
                return proxy
            attempts += 1
        self.failed_proxies.clear()
        if self.proxies: return self.proxies[0]
        return None
    def mark_failed(self, proxy: str):
        if proxy: self.failed_proxies.add(proxy)

# ==================== MIKROTIK AUTO-DETECT ====================
async def auto_detect_mikrotik() -> Optional[str]:
    def get_local_subnet():
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("8.8.8.8", 80))
            local_ip = s.getsockname()[0]
            s.close()
            base = local_ip.rsplit('.', 1)[0]
            return f"{base}.0/24"
        except:
            return "192.168.1.0/24"
    subnet = get_local_subnet()
    print(f"{BLUE}[*]{RESET} Scanning network: {subnet}")
    network = ip_network(subnet, strict=False)
    hosts = list(network.hosts())
    print(f"{YELLOW}[!]{RESET} Scanning {len(hosts)} IPs (ports 80,443,8080)...")
    async def check_host(session, ip, port):
        paths = ["/login", "/hotspot", "/"]
        for path in paths:
            url = f"http://{ip}:{port}{path}"
            try:
                async with session.get(url, timeout=2, allow_redirects=False) as resp:
                    text = await resp.text()
                    headers = dict(resp.headers)
                    if resp.status in (301,302,307,308):
                        loc = headers.get('Location','')
                        if 'login' in loc or 'hotspot' in loc:
                            full = loc if loc.startswith('http') else f"http://{ip}:{port}{loc}"
                            return full
                    if "MikroTik" in text or "RouterOS" in text:
                        meta = re.search(r'url=([^\'"\s]+)', text, re.I)
                        if meta:
                            redirect = meta.group(1).strip()
                            if not redirect.startswith('http'):
                                redirect = f"http://{ip}:{port}{redirect}"
                            return redirect
                        return url
            except: continue
        return None
    connector = aiohttp.TCPConnector(limit=100)
    timeout = aiohttp.ClientTimeout(total=3)
    async with aiohttp.ClientSession(timeout=timeout, connector=connector) as session:
        tasks = []
        for ip in hosts:
            for port in [80, 443, 8080]:
                tasks.append(check_host(session, str(ip), port))
        results = await asyncio.gather(*tasks)
        for res in results:
            if res:
                print(f"{GREEN}✅ Found MikroTik URL: {res}{RESET}")
                return res
    print(f"{RED}[-] No MikroTik device found on this network.{RESET}")
    return None
