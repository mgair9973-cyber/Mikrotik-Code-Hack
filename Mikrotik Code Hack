def get_machine_fingerprint():
    try:
        if os.name == 'nt':
            result = subprocess.check_output('wmic csproduct get uuid', shell=True).decode().split('\n')[1].strip()
            if result: return result
        else:
            if os.path.exists('/etc/machine-id'):
                with open('/etc/machine-id', 'r') as f:
                    return f.read().strip()
            elif os.path.exists('/var/lib/dbus/machine-id'):
                with open('/var/lib/dbus/machine-id', 'r') as f:
                    return f.read().strip()
    except: pass
    mac = ':'.join(['{:02x}'.format((uuid.getnode() >> ele) & 0xff) for ele in range(0, 2*6, 2)][::-1])
    return mac

def verify_base64_token(token, current_fp):
    try:
        decoded = base64.b64decode(token.encode()).decode()
        parts = decoded.split('|ZORO|')
        if len(parts) != 3:
            return False, None
        stored_fp = parts[0]
        expiry_timestamp = int(parts[1])
        stored_sig = parts[2]
        if stored_fp != current_fp:
            return False, None
        current_time = int(time.time())
        if expiry_timestamp >= UNLIMITED_TIMESTAMP:
            expiry_label = "♾️ Unlimited (Forever)"
            is_valid = True
        elif current_time > expiry_timestamp:
            expiry_date = datetime.fromtimestamp(expiry_timestamp).strftime("%Y-%m-%d %H:%M:%S")
            return False, f"Expired on: {expiry_date}"
        else:
            expiry_label = datetime.fromtimestamp(expiry_timestamp).strftime("%Y-%m-%d %H:%M:%S")
            is_valid = True
        expected_sig = hashlib.sha256((current_fp + str(expiry_timestamp) + MASTER_SALT).encode()).hexdigest()
        if stored_sig != expected_sig:
            return False, None
        return is_valid, expiry_label
    except: return False, None

